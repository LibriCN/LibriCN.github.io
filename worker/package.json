{
  "name": "livro-perto-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-loader ./tests/ts-loader.mjs --test tests/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply livro-perto-db --local",
    "db:seed:local": "wrangler d1 execute livro-perto-db --local --file=seed.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
